{
  "name": "locdrop-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local/server.ts",
    "dev:quiet": "cross-env LOG_REQUESTS=0 tsx src/local/server.ts",
    "db:init": "tsx scripts/create-table.ts",
    "db:reset": "tsx scripts/create-table.ts --reset",
    "seed": "tsx scripts/seed.ts",
    "token": "tsx scripts/token.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:a8": "tsx bench/a8/run.ts",
    "bench:b7": "tsx bench/b7/run.ts",
    "bench:b8": "cross-env TABLE_NAME=LocDropBench tsx bench/b8/run.ts",
    "bench:latency": "tsx bench/latency/run.ts",
    "build:lambdas": "tsx scripts/build-lambdas.ts",
    "deploy": "tsx scripts/deploy.ts",
    "smoke:aws": "tsx scripts/smoke-aws.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1168.0",
    "@aws-sdk/lib-dynamodb": "^3.1168.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "ngeohash": "^0.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
